# Postgres (Neon, region AWS Frankfurt: «pooled connection string» med sslmode=require)
DATABASE_URL=postgres://bruker:passord@vert/restoq?sslmode=require

# Restoq-administrator (opprettes ved oppstart)
ADMIN_EMAIL=
ADMIN_PASSWORD=minst-10-tegn

# Minst 32 tilfeldige tegn. Krypterer kundenes Tripletex-nøkler. Ikke bytt etter at kunder har koblet til.
SECRET_KEY=

APP_URL=https://restoq.no

# Logg inn med Google (Google Cloud → OAuth-klient, redirect https://restoq.no/api/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# E-post via Resend (domenet restoq.no må være bekreftet)
RESEND_API_KEY=
MAIL_FROM=Restoq <post@restoq.no>
LEADS_EMAIL=

# Tripletex (commercial integration)
TRIPLETEX_CONSUMER_TOKEN=
TRIPLETEX_ENV=test
TRIPLETEX_PAYMENT_TYPE=

LEGAL_ENTITY=
LEGAL_ORGNR=
PRIVACY_CONTACT=
